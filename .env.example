# Copy this file to .env.local and fill in the values.
# On Vercel: Project → Settings → Environment Variables.

# Required for the contact form and the chat widget to email you.
# Sign up at https://resend.com with omar.ali.set@gmail.com, then API Keys → Create.
RESEND_API_KEY=

# Optional: realtime #general chat server (socket.io). Leave empty to use
# the "Chat with Omar" mode that emails messages and auto-replies with contacts.
NEXT_PUBLIC_WS_URL=
